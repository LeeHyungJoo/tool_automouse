#pragma code_page(65001)
#include "resource.h"
#include "Version.h"
#include <afxres.h>

LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT

IDI_AUTOCLICKER_IDLE ICON "res\\idle.ico"
IDI_AUTOCLICKER_RUNNING ICON "res\\running.ico"
1 RT_MANIFEST "AutoClicker.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 330, 225
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AutoClicker 설정"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "클릭 간격", -1, 16, 18, 63, 12
    EDITTEXT        IDC_INTERVAL_EDIT, 82, 15, 122, 16, ES_AUTOHSCROLL | WS_TABSTOP
    COMBOBOX        IDC_INTERVAL_UNIT, 212, 15, 99, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "1~3,600,000 ms (최대 1시간) · 기본값 1,000 ms", -1, 16, 40, 298, 12
    LTEXT           "초 단위 입력 시 소수점(.)을 사용할 수 있습니다.", -1, 16, 55, 298, 12
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 16, 76, 296, 1
    CONTROL         "시작 위치 고정 (기본값: OFF)", IDC_FIXED_POSITION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 88, 298, 14
    LTEXT           "끄면 마우스 이동을 따라 현재 위치에서 클릭합니다.", -1, 16, 107, 298, 12
    LTEXT           "켜면 시작 위치로 이동해 계속 클릭합니다.", -1, 16, 123, 298, 12
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 16, 145, 296, 1
    LTEXT           "시작: Alt + C를 누른 채 P   /   정지: Alt + C를 누른 채 S", -1, 16, 157, 298, 12
    LTEXT           "설정창을 열면 정지합니다. 적용 후 시작 단축키로 다시 실행하세요.", IDC_STATUS_TEXT, 16, 174, 298, 12
    DEFPUSHBUTTON   "적용", IDOK, 194, 198, 56, 18
    PUSHBUTTON      "닫기", IDCANCEL, 256, 198, 56, 18
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AUTOCLICKER_VERSION_COMMA
 PRODUCTVERSION AUTOCLICKER_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
            VALUE "CompanyName", "MfcAutoClicker"
            VALUE "FileDescription", "MFC tray auto clicker"
            VALUE "FileVersion", AUTOCLICKER_VERSION_STRING
            VALUE "InternalName", "AutoClicker"
            VALUE "OriginalFilename", "AutoClicker.exe"
            VALUE "ProductName", "AutoClicker"
            VALUE "ProductVersion", AUTOCLICKER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200
    END
END
